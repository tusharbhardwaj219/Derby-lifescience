# ──────────────────────────────────────────────────────────────
#  Derby Lifescience — Backend configuration TEMPLATE
#  Copy to ".env" and fill in real values. NEVER commit real secrets here.
# ──────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# ── Database (MongoDB) ────────────────────────────────────────
#   local  → a real MongoDB runs on your PC automatically (no install, no cloud);
#            data in backend/.mongo-data, Compass at mongodb://127.0.0.1:27017.
#   Atlas  → mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/derby?retryWrites=true&w=majority
#            (URL-encode special characters in the password, e.g. "@" → "%40")
#   blank  → run without a database (inquiries are emailed only).
MONGODB_URI=local

# ── Email (Nodemailer / SMTP) ─────────────────────────────────
CONTACT_TO=info@fairfordpharma.com
MAIL_FROM="Derby Lifescience Website <your-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SEND_ACK=true

# ── Security ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://127.0.0.1:5500,http://127.0.0.1:5501
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
